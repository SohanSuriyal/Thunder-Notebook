{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thunder Notebook",
  "version": "0.1.0",
  "identifier": "com.thundernotebook.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thunder Notebook",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "A local desktop notebook for study and handwritten notes.",
    "longDescription": "Thunder Notebook is a desktop-first study notebook with subjects, topics, drawing, goals, favorites, timers, and PDF support.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
